# 条件循环演示

# 风格一：当 ... 循环 ... 结束（先判断）
变量 计数 = 0
变量 合计 = 0
当 计数 小于 5 循环
    计数++
    合计 += 计数
结束
打印("1 到 5 累加：", 合计)

# 风格二：重复 ... 直到 ... 结束（后判断，至少执行一次）
变量 次数 = 0
重复
    次数 = 次数 加 1
直到 次数 等于 3 结束
打印("重复次数：", 次数)

# 跳出与继续
变量 甲 = 0
变量 偶数 = []
当 真 循环
    甲 = 甲 加 1
    如果 甲 大于 10 那么
        跳出
    结束
    如果 甲 取余 2 不等于 0 那么
        继续
    结束
    偶数 = 追加(偶数, 甲)
结束
打印("十以内偶数：", 偶数)

# 配合数组遍历
变量 名单 = ["小明", "小红", "小刚"]
变量 下标 = 0
当 下标 小于 长度(名单) 循环
    打印(下标, 名单[下标])
    下标 = 下标 加 1
结束

# 风格三：重复 N 次 ... 结束（固定次数）
重复 3 次
    打印("你好")
结束

变量 名单二 = ["甲", "乙", "丙", "丁"]
变量 序 = 0
重复 长度(名单二) 次
    打印(序, 名单二[序])
    序 = 序 加 1
结束

变量 星 = []
重复 5 次
    星 = 追加(星, "*")
结束
打印("星号：", 星, "共", 长度(星), "个")

# 风格四：遍历 集合 中的 元素 [序号] ... 结束
变量 人员列表 = ["小明", "小红", "小刚"]
遍历 人员列表 中的 人 序号
    打印(序号, 人)
结束

变量 标签 = []
遍历 人员列表 中的 人
    标签 = 追加(标签, 人)
结束
打印("成员：", 标签)

遍历 "你好" 中的 字
    打印(字)
结束
