# 字典演示

变量 学生 = {
    "张三": 90,
    "李四": 85,
    "王五": 78,
}

打印("字典：", 学生)
打印("人数：", 长度(学生))

学生["赵六"] = 95
打印("张三的分数：", 学生["张三"])

变量 合计 = 0
遍历 学生 中的 姓名 分数
    合计 = 合计 加 分数
结束
打印("总分：", 合计)

变量 分数合计 = 0
遍历 学生 中的 分数
    分数合计 = 分数合计 加 分数
结束

打印("所有姓名：", 学生 的 键)
打印("所有分数：", 学生 的 值)

变量 计数器 = {}
变量 字 = 1
计数器[字] = "第一"
打印(计数器[1])

变量 配置 = {"debug": 真, "版本": 2}
如果 配置["debug"] 等于 真 那么
    打印("调试模式开启")
结束
